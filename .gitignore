artifacts/

# Untracked working directories, deliberately not committed:
#   frontend/ — a Node prototype (node_modules/ + dist/); nothing in this repo
#     imports it and app.py is the only UI. It is not a build input.
#   var/      — local runtime output: an SQLite database (plus its -wal/-shm),
#     logs, and an empty forecast_runs. Machine state, regenerated on use.
frontend/
var/
